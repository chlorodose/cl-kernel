From bbca027f8195302d94ec934bbf48b2facb51d4f5 Mon Sep 17 00:00:00 2001
From: chlorodose <chlorodose@chlorodose.me>
Date: Fri, 21 Aug 2026 14:28:43 +0800
Subject: [PATCH] bcachefs: fix compiler warnings

---
 fs/journal/reclaim.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/fs/journal/reclaim.c b/fs/journal/reclaim.c
index 3fdbe42..7c51425 100644
--- a/fs/journal/reclaim.c
+++ b/fs/journal/reclaim.c
@@ -97,10 +97,12 @@ void bch2_journal_set_watermark(struct journal *j)
 
 	watermark = max(watermark, j->watermark_open_buckets);
 
-	if (track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_space], low_on_space) |
-	    track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_pin], low_on_pin) |
-	    track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_open_buckets], j->watermark_open_buckets > 0) |
-	    track_event_change(&c->times[BCH_TIME_blocked_write_buffer_full], low_on_wb))
+	bool ev1 = track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_space], low_on_space),
+		 ev2 = track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_pin], low_on_pin),
+		 ev3 = track_event_change(&c->times[BCH_TIME_blocked_journal_low_on_open_buckets], j->watermark_open_buckets > 0),
+		 ev4 = track_event_change(&c->times[BCH_TIME_blocked_write_buffer_full], low_on_wb);
+
+	if (ev1 || ev2 || ev3 || ev4)
 		event_inc_trace(c, journal_full, buf, ({
 			guard(printbuf_atomic)(&buf);
 			prt_printf(&buf, "low_on_space %u\n",	low_on_space);
-- 
2.55.0

