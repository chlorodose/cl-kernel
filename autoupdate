#!/bin/sh
set -ex
DEPTH=100
cd "$(dirname "$0")/source"

git -C cachy fetch --depth "$DEPTH" origin master
git -C cachy reset --hard origin/master

TAG="$(LC_ALL=C dnf info nvidia-open | grep 'Available packages' -A 16 | grep Version | cut -d ':' -f 2 | xargs)"
git -C nvidia fetch --depth "$DEPTH" origin tag "$TAG"
git -C nvidia reset --hard "$TAG"

TAG="$(curl -fsSL https://api.github.com/repos/openzfs/zfs/releases/latest | jq -r '.tag_name')"
git -C zfs fetch --depth "$DEPTH" origin tag "$TAG"
git -C zfs reset --hard "$TAG"

TAG="$(curl -fsSL https://api.github.com/repos/koverstreet/bcachefs-tools/tags | jq -r '.[0].name')"
git -C bcachefs fetch --depth "$DEPTH" origin tag "$TAG"
git -C bcachefs reset --hard "$TAG"

TAG="$(curl -fsSL https://www.kernel.org/releases.json | jq -r '.releases.[] | select(.moniker == "stable") | .version' | head -n 1)"
git -C kernel fetch --depth "$DEPTH" origin tag "v$TAG"
git -C kernel reset --hard "v$TAG"
git -C xanmod fetch --depth "$DEPTH" origin tag "$TAG-xanmod1"
git -C xanmod reset --hard "$TAG-xanmod1"
